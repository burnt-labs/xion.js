// Quality gates for burnt-labs/github-workflows required-quality.yml. Run on
// pull requests by quality.yml and before every release by npm-changesets.yml
// (release.yml). Commands match the baseline table in .github/CI-MIGRATION.md.
{
  "schemaVersion": 1,
  "workingDirectory": ".",
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "lint": "pnpm lint",
    "prettier": "pnpm format:check",
    // check-types depends on ^build in turbo.json: workspace packages resolve
    // each other through dist types, and this gate runs before Build.
    "typeCheck": "pnpm turbo run check-types",
    // Zero-dependency script tests, then every package's unit suite. Live
    // network suites stay in integration-tests.yml and
    // dashboard-contract-validation.yml.
    "test": "pnpm test:scripts && pnpm test:unit",
    // abstraxion-core is the package that declares coverage thresholds, in its
    // vitest.config.ts; the values below are those, not new ones.
    "coverage": "pnpm test:coverage",
    // Regenerates the AA API types from testnet before building, as the
    // bespoke release.yml did.
    "build": "pnpm generate:types && pnpm build",
  },
  "coverageThresholds": {
    "lines": 50,
    "functions": 50,
    "branches": 40,
  },
}
